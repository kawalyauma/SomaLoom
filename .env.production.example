APP_ENV=production
POSTGRES_DB=somaloom
POSTGRES_USER=somaloom_owner
POSTGRES_PASSWORD=replace-with-64-random-hex-characters
REDIS_PASSWORD=replace-with-64-random-hex-characters
APP_DB_PASSWORD=replace-with-separate-random-password
DATABASE_URL=postgresql+psycopg://somaloom_app:replace-with-separate-random-password@db:5432/somaloom
REDIS_URL=redis://:replace-with-64-random-hex-characters@redis:6379/0
ALLOWED_ORIGINS=https://somaloom.example.org
SESSION_HOURS=12
STORAGE_ROOT=/data/resources
AI_PROVIDER=disabled
DATA_ROOT=/srv/somaloom-data
TLS_ROOT=/etc/somaloom/tls
BACKUP_BUCKET=your-private-versioned-s3-bucket
BACKUP_KMS_KEY_ID=your-kms-key-arn
